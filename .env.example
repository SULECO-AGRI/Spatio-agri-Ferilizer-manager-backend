# ==============================================================================
# SPATIO-AGRI BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# PostgreSQL Connection String (Prisma)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=<disable|verify-full|no-verify>
DATABASE_URL="postgresql://fertilizer_user:password@localhost:5432/fertilizer_manager?sslmode=disable"

# Allowed CORS Origins (comma-separated list for production/development frontends)
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:5173,http://localhost:3000"

# JWT Authentication Secret Key
JWT_SECRET="replace_with_a_secure_random_64_character_hex_secret_in_production"
