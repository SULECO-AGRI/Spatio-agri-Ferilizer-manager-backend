    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "farmerId",
      "value": "3",
      "type": "string"
    },
    {
      "key": "pilotId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "1",
      "type": "string"
    },
