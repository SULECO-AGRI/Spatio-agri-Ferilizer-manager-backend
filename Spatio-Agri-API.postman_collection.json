  "item": [
    {
      "name": "1. Health Checks",
      "item": [
        {
          "name": "1.1 Server Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Checks if the Express application server is up and operational."
          },
          "response": []
        },
        {
          "name": "1.2 Database Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": ["{{baseUrl}}"],
              "path": ["health", "db"]
            },
            "description": "Executes SELECT 1 to verify active PostgreSQL database connectivity."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication & Profile",
      "item": [
        {
          "name": "2.1 Register Farmer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"Saved farmer token to collection variables.\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer.sunil@example.com\",\n  \"password\": \"Farmer@123456\",\n  \"firstName\": \"Sunil\",\n  \"lastName\": \"Perera\",\n  \"mobile\": \"0712345678\",\n  \"nic\": \"199012345678\",\n  \"address\": \"123 Green Valley, Anuradhapura\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/farmer",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "farmer"]
            },
            "description": "Registers a new Farmer account with role 'Farmer' and creates 1:1 FarmerProfile."
          },
          "response": []
        },
        {
          "name": "2.2 Register Pilot (With Service Area)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"Saved pilot token to collection variables.\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pilot.nuwan@example.com\",\n  \"password\": \"Pilot@123456\",\n  \"firstName\": \"Nuwan\",\n  \"lastName\": \"Silva\",\n  \"mobile\": \"0779876543\",\n  \"serviceArea\": [\n    [6.9271, 79.8612],\n    [6.9371, 79.8712],\n    [6.9171, 79.8512],\n    [6.9271, 79.8612]\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/pilot",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "pilot"]
            },
            "description": "Registers a new Pilot account with serviceArea coordinates (selected on map / polygon), no mandatory license number, and default totalFlightHours = 0.00."
          },
          "response": []
        },
        {
          "name": "2.3 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"Saved token to collection variables.\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fertilizer.com\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates user credentials and returns JWT bearer access token."
          },
          "response": []
        },
        {
          "name": "2.4 Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Retrieves the authenticated user's profile and relation data based on JWT token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Admin Dashboard & Operations",
      "item": [
        {
          "name": "3.1 Dashboard Overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dashboard"]
