            "body": {
              "mode": "raw",
              "raw": "{\n  \"fieldName\": \"North Paddy Block A\",\n  \"cropType\": \"Paddy\",\n  \"area\": 4.5,\n  \"locationCoordinates\": [\n    [8.3114, 80.4037],\n    [8.3150, 80.4080],\n    [8.3100, 80.4120],\n    [8.3050, 80.4050]\n  ],\n  \"province\": \"North Central\",\n  \"district\": \"Anuradhapura\",\n  \"city\": \"Medawachchiya\",\n  \"village\": \"Pahalagama\"\n}"
