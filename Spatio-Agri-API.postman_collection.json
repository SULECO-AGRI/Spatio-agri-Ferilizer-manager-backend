            "description": "Updates the role of a user (Admin Only)."
          },
          "response": []
        },
        {
          "name": "3.4 Activity Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/activity-logs?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "activity-logs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Audit trail log of all system actions and assignments."
          },
          "response": []
        }
      ]
    },
