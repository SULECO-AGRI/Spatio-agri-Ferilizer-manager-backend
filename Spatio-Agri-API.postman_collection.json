            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleName\": \"Pilot\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/users/{{pilotId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users", "{{pilotId}}", "role"]
