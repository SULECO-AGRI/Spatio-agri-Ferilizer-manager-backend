  "item": [
    {
      "name": "1. Health Checks",
      "item": [
        {
          "name": "Server Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Checks if the Express application server is up and responsive."
          },
          "response": []
        },
        {
          "name": "Database Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": ["{{baseUrl}}"],
              "path": ["health", "db"]
            },
            "description": "Executes a SELECT 1 query to verify active PostgreSQL database connectivity."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication & Authorization",
      "item": [
        {
          "name": "Register Farmer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"Saved farmer token to collection variables.\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer.sunil@example.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Sunil\",\n  \"lastName\": \"Perera\",\n  \"mobile\": \"0712345678\",\n  \"nic\": \"199012345678\",\n  \"address\": \"123 Green Valley, Anuradhapura\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/farmer",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", "farmer"]
            },
            "description": "Registers a new Farmer account with role 'Farmer' and 1:1 FarmerProfile."
          },
          "response": []
        },
