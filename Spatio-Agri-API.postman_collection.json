    {
      "name": "4. Pilots Management",
      "item": [
        {
          "name": "4.1 List All Pilots (Directory)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["pilots"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            },
            "description": "Lists pilots with search, status filters, and rating sorting."
          },
          "response": []
        },
        {
          "name": "4.2 Get Pilot By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}"]
            },
            "description": "Retrieves comprehensive profile, licence, flight hours, and statistics for a specific pilot."
          },
          "response": []
        },
        {
          "name": "4.3 Update Pilot Duty Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "status"]
            },
            "description": "Updates pilot availability status (ACTIVE, INACTIVE, ON_MISSION, SUSPENDED)."
          },
          "response": []
        },
        {
          "name": "4.4 Get Pilot Mission History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/missions?page=1&limit=10&status=SCHEDULED",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "missions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "SCHEDULED" }
              ]
            },
            "description": "Retrieves assigned missions for the pilot."
          },
          "response": []
        },
        {
          "name": "4.5 Start Mission Execution",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/missions/{{missionId}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "missions", "{{missionId}}", "start"]
            },
            "description": "Transitions scheduled mission to IN_PROGRESS and marks pilot ON_MISSION."
          },
          "response": []
        },
        {
          "name": "4.6 Complete Mission Execution",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightHours\": 1.5,\n  \"fertilizerAppliedKg\": 45.0,\n  \"notes\": \"Spraying completed with 100% boundary coverage.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/missions/{{missionId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "missions", "{{missionId}}", "complete"]
            },
            "description": "Completes a mission atomically, logs flight hours, applied kg, and restores pilot status."
          },
          "response": []
        },
        {
          "name": "4.7 Pilot Respond to Mission (Accept/Reject)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"response\": \"ACCEPT\",\n  \"reason\": \"Weather conditions optimal, drone prepped\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pilots/missions/{{missionId}}/respond",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "missions", "{{missionId}}", "respond"]
            },
            "description": "Pilot accepts or rejects an assigned mission."
          },
          "response": []
        },
        {
          "name": "4.8 Get Pilot Financial Payouts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/payouts?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "payouts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Retrieves financial payout records and settlement ledger for the pilot."
          },
          "response": []
        },
        {
          "name": "4.9 Get Pilot Reviews & Ratings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/reviews?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "reviews"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Retrieves performance reviews and customer satisfaction ratings for the pilot."
          },
          "response": []
        }
      ]
    },
