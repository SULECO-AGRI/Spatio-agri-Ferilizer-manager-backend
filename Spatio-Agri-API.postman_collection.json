    {
      "name": "5. Pilots Management",
      "item": [
        {
          "name": "5.1 List All Pilots (Directory)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["pilots"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sortBy", "value": "createdAt" },
                { "key": "sortOrder", "value": "desc" }
              ]
            },
            "description": "Lists pilots with search, status filters, ratings, and serviceArea coordinates."
          },
          "response": []
        },
        {
          "name": "5.2 Get Pilot Profile & Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}"]
            },
            "description": "Detailed pilot profile including flight statistics, earnings, and serviceArea."
          },
          "response": []
        },
        {
          "name": "5.3 Update Pilot Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "application/json": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "status"]
            },
            "description": "Changes pilot status between ACTIVE, INACTIVE, ON_MISSION, or SUSPENDED."
          },
          "response": []
        },
        {
          "name": "5.4 Pilot Assigned Missions History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/missions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "missions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Lists missions assigned to the pilot."
          },
          "response": []
        },
        {
          "name": "5.5 Get Single Mission Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/missions/{{missionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "missions", "{{missionId}}"]
            },
            "description": "Full details of a specific drone mission including field coordinates and farmer contact."
          },
          "response": []
        },
        {
          "name": "5.6 Respond to Mission (Accept/Reject)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"ACCEPT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/missions/{{missionId}}/respond",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "missions", "{{missionId}}", "respond"]
            },
            "description": "Allows an assigned pilot to ACCEPT or REJECT a scheduled mission."
          },
          "response": []
        },
        {
          "name": "5.7 Start Flight Mission",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/missions/{{missionId}}/start",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "missions", "{{missionId}}", "start"]
            },
            "description": "Marks a mission as IN_PROGRESS and sets the pilot status to ON_MISSION."
          },
          "response": []
        },
        {
          "name": "5.8 Complete Flight Mission",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"areaSpread\": 5.5,\n  \"flightDurationHours\": 1.25,\n  \"pilotNotes\": \"Fertilizer sprayed evenly over the 5.5 acre paddy block.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/missions/{{missionId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "missions", "{{missionId}}", "complete"]
            },
            "description": "Completes the mission, logs flight hours and area sprayed, and creates payout record."
          },
          "response": []
        },
        {
          "name": "5.9 Pilot Payouts History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/payouts?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "payouts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Lists earnings and payout settlements for the pilot."
          },
          "response": []
        },
        {
          "name": "5.10 Pilot Customer Reviews",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/pilots/{{pilotId}}/reviews?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["pilots", "{{pilotId}}", "reviews"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Lists ratings and reviews left by farmers for completed missions."
          },
          "response": []
        }
      ]
    },
    {
