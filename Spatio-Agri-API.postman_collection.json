        {
          "name": "6.6 Get Farmer Service Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/farmers/{{farmerId}}/service-requests?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["farmers", "{{farmerId}}", "service-requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Lists all spraying service requests placed by the farmer."
          },
          "response": []
        },
        {
